{
  "name": "wechat-summarizer-desktop",
  "version": "1.1.0",
  "description": "微信消息 AI 助手 - 桌面版（Electron 套壳网页版）",
  "main": "main.js",
  "author": "kevin0521-wjw",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "doctor": "node -e \"require('child_process').spawnSync('python',['../scripts/doctor.py'],{stdio:'inherit',shell:true})\""
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kevin.wechat-summarizer",
    "productName": "微信消息AI助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../backend-dist",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../vendor",
        "to": "backend/vendor",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "微信消息AI助手"
    }
  }
}

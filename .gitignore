# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 数据 / 运行时产物
data/
output/
backend-dist/
build-tmp/
release/
*.spec

# 可选依赖的隔离环境（约 100 MB，不进仓库；由 scripts/setup_optional.py 生成，
# 打包时由 build_backend.py 复制进安装包）
vendor/pywxdump_venv/
vendor/**/__pycache__/

# 依赖 / 打包
node_modules/
desktop/release/
desktop/dist-release/
# 构建工作区：electron-builder 的输出（安装包约 300 MB）+ winCodeSign 补丁中间物
# 由 scripts/build_installer_local_mirror.py 生成，可随时重建，不进仓库
wms-build/

# 敏感配置（含 key，勿提交）
config.local.yaml
.token.tmp
*.token

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
